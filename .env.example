# Used only by domain_assistant.py when generating real RAG answers.
# Copy this file to .env, then replace the placeholder value.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Optional: use Groq (OpenAI-compatible endpoint) instead of OpenAI.
# Set LLM_PROVIDER=groq and fill GROQ_API_KEY / GROQ_MODEL. Default provider is openai.
# LLM_PROVIDER=openai
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=openai/gpt-oss-120b
